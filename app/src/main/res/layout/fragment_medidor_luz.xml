<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:fillViewport="true"
    tools:context=".ui.medidorLuz.MedidorLuzFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ HERO ════════════════════════════════════════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_emoji_circle_kit"
                android:padding="16dp"
                android:src="@drawable/ic_ug_sun"
                app:tint="@color/color_primary"
                android:contentDescription="Medidor de luz"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Medidor de luz"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ TARJETA DE LECTURA EN VIVO ══════════════════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/color_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Valor de lux en vivo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLuxValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/color_on_surface"
                        android:textSize="52sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="12dp"
                        android:text="lux"
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="18sp"/>
                </LinearLayout>

                <!-- Nivel de luz textual -->
                <TextView
                    android:id="@+id/tvNivelLuz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pulsa Empezar para medir"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="14sp"/>

                <!-- Barra visual de intensidad -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbIntensidadLuz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/color_primary"
                    app:trackColor="@color/color_surface_variant"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ BOTÓN EMPEZAR / DETENER ═════════════════════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMedir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:padding="14dp"
            android:text="Empezar medición"
            android:textSize="15sp"
            app:backgroundTint="@color/color_primary"
            app:icon="@drawable/ic_ug_play"
            app:iconGravity="textStart"
            app:cornerRadius="14dp"/>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ TARJETA DE VEREDICTO (oculta hasta medir) ═══════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVeredicto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_primary_container"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivVeredictoIcono"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_emoji_circle_kit"
                        android:padding="12dp"
                        app:tint="@color/color_primary"
                        android:contentDescription="Estado de luz"
                        tools:src="@drawable/ic_ug_check"/>

                    <TextView
                        android:id="@+id/tvVeredictoTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/color_on_surface"
                        tools:text="Luz suficiente"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="#33000000"/>

                <!-- Lo que necesita la planta -->
                <TextView
                    android:id="@+id/tvNecesidadPlanta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2sp"
                    android:textColor="@color/color_on_surface"
                    tools:text="La albahaca necesita luz brillante indirecta (2.000–10.000 lux)."
                    android:textSize="13sp"/>

                <!-- Recomendación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_ug_bulb"
                        app:tint="@color/color_primary"
                        android:contentDescription="Consejo"/>

                    <TextView
                        android:id="@+id/tvVeredictoConsejo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2sp"
                        android:textColor="@color/color_on_surface"
                        tools:text="La ubicación actual es ideal. Mantén la planta donde está."
                        android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ AVISO SIN SENSOR (oculto por defecto) ═══════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSinSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/color_outline"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_emoji_circle_kit"
                    android:padding="12dp"
                    android:src="@drawable/ic_notif_alerta"
                    app:tint="@color/color_aviso"
                    android:contentDescription="Aviso"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2sp"
                    android:text="Tu dispositivo no tiene sensor de luz. Coloca el móvil junto a la planta, orientado hacia la fuente de luz, y observa el brillo de la pantalla como referencia aproximada."
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="13sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
