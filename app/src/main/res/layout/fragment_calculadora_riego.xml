<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:fillViewport="true"
    tools:context=".ui.calculadoraRiego.CalculadoraRiegoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ HERO ════════════════════════════════════════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_emoji_circle_kit"
                android:padding="16dp"
                android:src="@drawable/ic_ug_drop"
                app:tint="@color/color_primary"
                android:contentDescription="Calculadora de riego"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Calculadora de riego"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ CARD DE INPUTS ══════════════════════════════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/color_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ───────────────────────────────────────────────────── -->
                <!-- 1. Ubicación interior/exterior -->
                <!-- ───────────────────────────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Dónde tienes tu kit?"
                    android:drawableStart="@drawable/ic_ug_location"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/color_primary"
                    android:textColor="@color/color_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUbicInterior"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Interior"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUbicExterior"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Exterior"
                        android:textSize="12sp"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/color_surface_variant"/>

                <!-- ───────────────────────────────────────────────────── -->
                <!-- 2. Horas de sol -->
                <!-- ───────────────────────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Horas de sol al día"
                        android:drawableStart="@drawable/ic_ug_sun"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/color_primary"
                        android:textColor="@color/color_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvHorasSol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 h"
                        android:textColor="@color/color_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderHorasSol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:stepSize="1"
                    android:value="6"
                    android:valueFrom="0"
                    android:valueTo="12"
                    app:thumbColor="@color/color_primary"
                    app:trackColorActive="@color/color_primary"
                    app:trackColorInactive="@color/color_primary_container"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/color_surface_variant"/>

                <!-- ───────────────────────────────────────────────────── -->
                <!-- 3. Tamaño del kit -->
                <!-- ───────────────────────────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamaño de tu kit UrbanGarden"
                    android:drawableStart="@drawable/ic_ug_plant"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/color_primary"
                    android:textColor="@color/color_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleTamano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTamPequeno"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pequeño"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTamMediano"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mediano"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTamGrande"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Grande"
                        android:textSize="12sp"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ BOTÓN CALCULAR ══════════════════════════════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:padding="14dp"
            android:text="Calcular riego"
            android:textSize="15sp"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="14dp"/>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!-- ══ TARJETA DE RESULTADO ════════════════════════════════════ -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_primary_container"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Tu planta necesita"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="13sp"/>

                <!-- Cantidad por riego -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvResultadoMl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_on_surface"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        tools:text="120"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="10dp"
                        android:text="ml al día"
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="#33000000"/>

                <!-- Consejo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_ug_bulb"
                        app:tint="@color/color_primary"
                        android:contentDescription="Consejo"/>

                    <TextView
                        android:id="@+id/tvResultadoConsejo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2sp"
                        android:textColor="@color/color_on_surface"
                        tools:text="Riega lentamente alrededor del tallo, evitando mojar las hojas."
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Botón registrar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarRiego"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Registrar este riego"
                    android:textSize="14sp"
                    app:backgroundTint="@color/color_primary"
                    app:cornerRadius="12dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
