<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo oscuro del visor QR simulado, para que parezca la vista de la cámara
     y resalten las esquinas y el texto blancos. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1A1A1A"/>
    <stroke android:width="2dp" android:color="@color/color_primary_light"/>
    <corners android:radius="16dp"/>
</shape>
