<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo de las tarjetas de métricas (humedad, temperatura, luz, edad) dentro
    de cada item de la lista de kits. Es un cuadrado claro con borde fino, que
    contrasta bien sobre el fondo blanco de la tarjeta principal del kit.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F1F8E9" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="#C5D9B8" />
</shape>
